<?xml version="1.0" encoding="utf-8"?>
<!-- Simulation-only OAK-D Pro W: a colour camera (named mono_left: the luxonis_oak plugin of 2026-10 takes its sim RGB from that sensor) (IMX378, HFOV ~108 deg) and a depth camera aligned to it
     (same origin, same FOV, half resolution). The real-device description with the OV9282 mono pair is
     oakd_pro_w_poe_ov9282.xml. -->
<sensor_set name="oakd_pro_w_sim">
    <link>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.184" />
            <inertia ixx="0.000039555" ixy="0.0" ixz="0.0" iyy="0.000203944" iyz="0.0" izz="0.000213455" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.031 0.111 0.040" />
            </geometry>
            <material name="">
                <color rgba="0.2 0.2 0.2 1" />
            </material>
        </visual>

        <sensor name="mono_left" type="rgb" update_rate="6">
            <origin rpy="0 0 0" xyz="0.02 0 0"/>
            <camera horizontal_fov="1.885">
                <image width="1280" height="960"/>
                <clip near="0.1" far="30"/>
                <noise type="gaussian" mean="0.0" stddev="0.004"/>
            </camera>
        </sensor>

        <sensor name="depth" type="depth" update_rate="6">
            <data type="coordinates"/>
            <origin rpy="0 0 0" xyz="0.02 0 0"/>
            <camera horizontal_fov="1.885">
                <image width="640" height="480"/>
                <clip near="0.2" far="12"/>
                <noise type="gaussian" mean="0.0" stddev="0.004"/>
            </camera>
        </sensor>
    </link>
</sensor_set>
