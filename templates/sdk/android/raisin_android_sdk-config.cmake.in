# @SDK_NAME@ - communication-only Raisin core for Android.
#
# Generated by `raisin build_sdk android`. Headers, binaries, compile definitions and
# IDL in this prefix all come from one SDK build; mixing them with another build
# is not supported.

get_filename_component(RAISIN_ANDROID_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)

set(RAISIN_ANDROID_SDK_VERSION "@SDK_VERSION@")
set(RAISIN_ANDROID_SDK_PROTOCOL_VERSION @PROTOCOL_VERSION@)
set(RAISIN_ANDROID_SDK_PROFILE "@PROFILE@")
set(RAISIN_ANDROID_SDK_ABI "@ABI@")
set(RAISIN_ANDROID_SDK_API_LEVEL @API_LEVEL@)
set(RAISIN_ANDROID_SDK_STL "@STL@")
set(RAISIN_ANDROID_SDK_NDK_VERSION "@NDK_VERSION@")
set(RAISIN_ANDROID_SDK_BUILD_TYPE "@BUILD_TYPE@")
set(RAISIN_ANDROID_SDK_IDL_DIR "${RAISIN_ANDROID_SDK_ROOT}/idl")
set(RAISIN_ANDROID_SDK_JNILIBS_DIR "${RAISIN_ANDROID_SDK_ROOT}/jniLibs")
set(RAISIN_ANDROID_SDK_METADATA "${RAISIN_ANDROID_SDK_ROOT}/raisin_sdk.json")

# --- consumer/SDK compatibility -------------------------------------------
# The public C++ API is templated and feature-dependent, so a consumer built
# against different settings would compile against the wrong declarations.

if(NOT ANDROID)
    message(FATAL_ERROR
            "@SDK_NAME@ is an Android SDK but this build is not using the Android "
            "NDK toolchain. Configure with "
            "-DCMAKE_TOOLCHAIN_FILE=<ndk>/build/cmake/android.toolchain.cmake.")
endif()

if(NOT ANDROID_ABI STREQUAL RAISIN_ANDROID_SDK_ABI)
    message(FATAL_ERROR
            "@SDK_NAME@ was built for ABI '${RAISIN_ANDROID_SDK_ABI}' but this build "
            "targets '${ANDROID_ABI}'. Build the SDK with "
            "`raisin build_sdk android --abi ${ANDROID_ABI}`.")
endif()

if(NOT RAISIN_ANDROID_SDK_STL STREQUAL "c++_shared")
    message(FATAL_ERROR
            "@SDK_NAME@ contains multiple shared libraries and requires c++_shared. "
            "Rebuild this SDK with --stl c++_shared.")
endif()

if(NOT ANDROID_STL STREQUAL RAISIN_ANDROID_SDK_STL)
    message(FATAL_ERROR
            "@SDK_NAME@ was built against ANDROID_STL='${RAISIN_ANDROID_SDK_STL}' but "
            "this build uses '${ANDROID_STL}'. Two C++ runtimes in one process is "
            "undefined behaviour; set ANDROID_STL=${RAISIN_ANDROID_SDK_STL}.")
endif()

# Pin the actual toolchain revision, not just a user-supplied version variable.
# libc++_shared is packaged by the consumer's NDK, so the SDK and consumer must
# use the same revision until a broader compatibility policy is validated.
function(_raisin_sdk_check_ndk)
    if(NOT CMAKE_ANDROID_NDK OR NOT EXISTS "${CMAKE_ANDROID_NDK}/source.properties")
        message(FATAL_ERROR "@SDK_NAME@ cannot determine the consumer NDK revision. "
                "Configure with the Android NDK toolchain.")
    endif()
    file(STRINGS "${CMAKE_ANDROID_NDK}/source.properties" _revision
            REGEX "^Pkg\\.Revision[ \t]*=" LIMIT_COUNT 1)
    string(REGEX REPLACE "^Pkg\\.Revision[ \t]*=[ \t]*" "" _revision "${_revision}")
    string(STRIP "${_revision}" _revision)
    if(NOT _revision STREQUAL RAISIN_ANDROID_SDK_NDK_VERSION)
        message(FATAL_ERROR
                "@SDK_NAME@ requires NDK ${RAISIN_ANDROID_SDK_NDK_VERSION}, but this "
                "build uses '${_revision}' at '${CMAKE_ANDROID_NDK}'. Set Gradle "
                "ndkVersion to '${RAISIN_ANDROID_SDK_NDK_VERSION}' or rebuild the SDK "
                "with --ndk pointing to the consumer NDK.")
    endif()
endfunction()
_raisin_sdk_check_ndk()

# The NDK's legacy toolchain pins CMAKE_SYSTEM_VERSION to 1, so the API level has
# to come from the Android-specific variables.
set(_raisin_sdk_consumer_api "")
if(ANDROID_PLATFORM_LEVEL MATCHES "^[0-9]+$")
    set(_raisin_sdk_consumer_api "${ANDROID_PLATFORM_LEVEL}")
elseif(ANDROID_PLATFORM MATCHES "android-([0-9]+)")
    set(_raisin_sdk_consumer_api "${CMAKE_MATCH_1}")
elseif(ANDROID_NATIVE_API_LEVEL MATCHES "^([0-9]+)$")
    set(_raisin_sdk_consumer_api "${CMAKE_MATCH_1}")
elseif(CMAKE_SYSTEM_VERSION MATCHES "^[0-9]+$" AND CMAKE_SYSTEM_VERSION GREATER 1)
    set(_raisin_sdk_consumer_api "${CMAKE_SYSTEM_VERSION}")
endif()

if(_raisin_sdk_consumer_api STREQUAL "")
    message(WARNING
            "@SDK_NAME@ could not determine this build's Android API level; skipping "
            "the minSdk compatibility check.")
elseif(_raisin_sdk_consumer_api LESS RAISIN_ANDROID_SDK_API_LEVEL)
    message(FATAL_ERROR
            "@SDK_NAME@ requires Android API ${RAISIN_ANDROID_SDK_API_LEVEL} or newer "
            "but this build targets API ${_raisin_sdk_consumer_api}. Either raise "
            "minSdk or rebuild the SDK with --api ${_raisin_sdk_consumer_api}.")
endif()
unset(_raisin_sdk_consumer_api)

if(DEFINED RAISIN_EXPECTED_PROTOCOL_VERSION AND
        NOT RAISIN_EXPECTED_PROTOCOL_VERSION EQUAL RAISIN_ANDROID_SDK_PROTOCOL_VERSION)
    message(FATAL_ERROR
            "@SDK_NAME@ speaks raisin protocol ${RAISIN_ANDROID_SDK_PROTOCOL_VERSION} but "
            "this application expects ${RAISIN_EXPECTED_PROTOCOL_VERSION}. Rebuild the "
            "SDK from a matching raisin_master, or update "
            "RAISIN_EXPECTED_PROTOCOL_VERSION.")
endif()

# --- transitive packages ---------------------------------------------------
# The NDK toolchain sets CMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY, which re-roots
# find_package() under the sysroot and would hide this prefix. Relax it for the
# duration of this file only; by the time it is restored every target exists.

function(_raisin_sdk_load_packages)
    get_property(_loaded_root GLOBAL PROPERTY RAISIN_ANDROID_SDK_LOADED_ROOT)
    if(_loaded_root AND NOT _loaded_root STREQUAL RAISIN_ANDROID_SDK_ROOT)
        message(FATAL_ERROR "Cannot combine Raisin SDKs '${_loaded_root}' and "
                "'${RAISIN_ANDROID_SDK_ROOT}' in one build.")
    endif()
    if(NOT _loaded_root)
        foreach(_target IN ITEMS raisin_network raisin_thread_pool raisin_encryption
                raisin_empty_encryption raisin_compat zstd::libzstd)
            if(TARGET ${_target})
                message(FATAL_ERROR "Target '${_target}' was defined outside the selected "
                        "Raisin SDK. Load the SDK before its bundled dependencies.")
            endif()
        endforeach()
    endif()

    # Also override normal variables: a parent project may have set <pkg>_DIR.
    # Replacing only the umbrella package would still leave transitive libraries
    # and headers pointing at the old SDK after a prefix change.
    foreach(_package IN ITEMS @BUNDLED_PACKAGES@)
        set(_dir "${RAISIN_ANDROID_SDK_ROOT}/lib/cmake/${_package}")
        if(NOT EXISTS "${_dir}/${_package}Config.cmake")
            message(FATAL_ERROR "Incomplete Raisin SDK: missing ${_dir}/${_package}Config.cmake")
        endif()
        set(${_package}_DIR "${_dir}" CACHE PATH "Package from the selected Raisin SDK" FORCE)
        set(${_package}_DIR "${_dir}")
    endforeach()
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
    list(PREPEND CMAKE_PREFIX_PATH "${RAISIN_ANDROID_SDK_ROOT}")
    find_package(raisin_network REQUIRED CONFIG
            PATHS "${RAISIN_ANDROID_SDK_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    set_property(GLOBAL PROPERTY RAISIN_ANDROID_SDK_LOADED_ROOT "${RAISIN_ANDROID_SDK_ROOT}")
endfunction()
_raisin_sdk_load_packages()

if(NOT TARGET raisin::network_android)
    add_library(raisin::network_android INTERFACE IMPORTED)
    set_target_properties(raisin::network_android PROPERTIES
            INTERFACE_LINK_LIBRARIES "raisin_network;android;log"
            INTERFACE_INCLUDE_DIRECTORIES "${RAISIN_ANDROID_SDK_ROOT}/include")
endif()

set(@SDK_NAME@_FOUND TRUE)
